user := env("DOCKERHUB_USER", "akhilfolium")
docker := env("DOCKER", if path_exists("/usr/bin/podman") == "true" { "podman" } else { "docker" })

# Build image (context is parent dir for shared pyproject.toml)
build:
    {{docker}} build -t {{user}}/echo-agent -f {{justfile_directory()}}/Dockerfile {{justfile_directory()}}/..

# Push image
push:
    {{docker}} push {{user}}/echo-agent

# Build + push
release: build push
