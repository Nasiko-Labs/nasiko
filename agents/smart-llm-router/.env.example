# Smart LLM Router agent
#
# Downstream Nasiko (or DronaHQ mock) — one var switches mock ↔ prod.
ROUTER_BASE_URL=http://localhost:8080
# ROUTER_BASE_URL=http://localhost:8090

# When this process is the analytics host, leave unset.
# When this process is a *deployed* Nasiko agent container, point at the host dashboard:
# ANALYTICS_INGEST_URL=http://host.docker.internal:8000/api/ingest
# Optional shared secret for /api/stats|/api/events|/api/ingest|/api/turn (set on both sides):
# ANALYTICS_TOKEN=change-me
# With a token set, open the dashboard as http://127.0.0.1:8000/ui/?token=change-me

# Optional classifier LLM (Groq). Without it the agent uses a fast local heuristic
# (recommended — avoids 20s hangs on the agent's OpenAI gateway JWT).
# CLASSIFIER_API_KEY=gsk_...
# CLASSIFIER_BASE_URL=https://api.groq.com/openai/v1
# CLASSIFIER_MODEL=llama-3.1-8b-instant

# ROUTER_TIMEOUT_SECS=30
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=smart-llm-router-agent
