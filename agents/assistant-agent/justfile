user := env("DOCKERHUB_USER", "akhilfolium")
docker := env("DOCKER", if path_exists("/usr/bin/podman") == "true" { "podman" } else { "docker" })

# Build image (self-contained: per-agent pyproject.toml lives in this dir).
# linux/amd64: the platform's agent nodes (EKS/DOKS/AKS pools) are amd64.
build:
    {{docker}} build --platform linux/amd64 -t {{user}}/assistant-agent -f {{justfile_directory()}}/Dockerfile {{justfile_directory()}}

# Push image
push:
    {{docker}} push {{user}}/assistant-agent

# Build + push
release: build push
