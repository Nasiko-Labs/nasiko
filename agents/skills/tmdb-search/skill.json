{
  "apiVersion": "nasiko.dev/v1",
  "kind": "Skill",
  "metadata": {
    "name": "tmdb-search",
    "version": "1.0.0",
    "description": "Search TMDB for movies or TV shows by title or keyword",
    "tags": ["search", "movies", "tv", "entertainment"],
    "author": "nasiko"
  },
  "interface": {
    "function": "tmdb_search",
    "inputs": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Movie or TV show title to search" },
        "media_type": { "type": "string", "description": "Type: movie or tv", "default": "movie" },
        "max_results": { "type": "integer", "description": "Maximum results (1-10)", "default": 5 }
      },
      "required": ["query"]
    },
    "output": { "type": "string", "description": "Formatted list of movies/shows with titles, ratings, and overviews" }
  },
  "runtime": {
    "language": "python",
    "entrypoint": "impl.py",
    "dependencies": ["httpx>=0.27.0"],
    "env_vars": ["TMDB_API_KEY"]
  },
  "frameworks": {
    "openai": { "decorator": "function_tool", "import_from": "agents" },
    "claude-sdk": { "style": "tool_definition" },
    "langgraph": { "decorator": "tool", "import_from": "langchain_core.tools" },
    "crewai": { "decorator": "tool", "import_from": "crewai.tools" },
    "a2a-go": { "style": "handler" }
  }
}
