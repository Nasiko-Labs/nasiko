{
  "apiVersion": "nasiko.dev/v1",
  "kind": "Skill",
  "metadata": {
    "name": "arxiv-search",
    "version": "1.0.0",
    "description": "Search academic papers on arXiv by keyword, topic, or author",
    "tags": ["search", "academic", "research", "papers"],
    "author": "nasiko"
  },
  "interface": {
    "function": "arxiv_search",
    "inputs": {
      "type": "object",
      "properties": {
        "query": { "type": "string", "description": "Search query (keyword, topic, or author name)" },
        "max_results": { "type": "integer", "description": "Maximum papers to return (1-10)", "default": 5 },
        "sort_by": { "type": "string", "description": "Sort order: newest, relevance, or updated", "default": "newest" }
      },
      "required": ["query"]
    },
    "output": { "type": "string", "description": "Formatted list of papers with titles, authors, abstracts, and links" }
  },
  "runtime": {
    "language": "python",
    "entrypoint": "impl.py",
    "dependencies": ["httpx>=0.27.0"],
    "env_vars": []
  },
  "frameworks": {
    "openai": { "decorator": "function_tool", "import_from": "agents" },
    "claude-sdk": { "style": "tool_definition" },
    "langgraph": { "decorator": "tool", "import_from": "langchain_core.tools" },
    "crewai": { "decorator": "tool", "import_from": "crewai.tools" },
    "a2a-go": { "style": "handler" }
  }
}
