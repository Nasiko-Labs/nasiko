user := env("DOCKERHUB_USER", "akhilfolium")
docker := env("DOCKER", if path_exists("/usr/bin/podman") == "true" { "podman" } else { "docker" })

# Build image
build:
    {{docker}} build -t {{user}}/nutrition .

# Push image
push:
    {{docker}} push {{user}}/nutrition

# Build + push
release: build push
