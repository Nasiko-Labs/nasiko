# GitHub classic PAT with public_repo scope (needed only for G3: fork + push + PR)
GITHUB_TOKEN=
# OpenAI-compatible key (needed only for docs-mode contributions; self-mode needs no LLM)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
MODEL=gpt-4o-mini
# Upstream repos this agent may write to — one per entry, comma-separated, no wildcards
WRITABLE_REPOS=Nasiko-Labs/nasiko
# Public base URL used in detail links (your tunnel URL)
PUBLIC_URL=http://localhost:8001
# If set, POST /a2a/approve requires header X-Approver-Key with this value
APPROVER_KEY=
MAX_COST_USD=0.50
# auto | self | docs
CONTRIBUTION_MODE=auto
