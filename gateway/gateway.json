{
  "listen_addr": "0.0.0.0:8080",
  "tls": null,
  "jwt_secret": "dev-secret-change-in-production",
  "rate_limits": {
    "ip_requests_per_second": 100,
    "user_requests_per_second": 50,
    "burst_multiplier": 2
  },
  "routes": [
    {
      "path_prefix": "/health",
      "upstream": "server:8080",
      "strip_prefix": false,
      "require_auth": false
    },
    {
      "path_prefix": "/.well-known/",
      "upstream": "server:8080",
      "strip_prefix": false,
      "require_auth": false
    },
    {
      "path_prefix": "/api/auth/initialize-admin",
      "upstream": "server:8080",
      "strip_prefix": false,
      "require_auth": false
    },
    {
      "path_prefix": "/api/auth/login",
      "upstream": "server:8080",
      "strip_prefix": false,
      "require_auth": false
    },
    {
      "path_prefix": "/api/",
      "upstream": "server:8080",
      "strip_prefix": false,
      "require_auth": true
    },
    {
      "path_prefix": "/v2/",
      "upstream": "server:8080",
      "strip_prefix": false,
      "require_auth": true
    }
  ],
  "cors": {
    "allowed_origins": ["*"],
    "allowed_methods": ["GET", "POST", "PUT", "DELETE", "OPTIONS", "PATCH"],
    "allowed_headers": ["Content-Type", "Authorization", "traceparent"]
  }
}
