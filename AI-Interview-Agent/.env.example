# ==============================================================================
# LLM Providers (Configure at least one; Amazon Bedrock or Gemini or OpenAI)
# ==============================================================================

# Amazon Bedrock Configuration:
# You can provide either:
# Option A: A direct Bedrock API Key / Bearer Token
BEDROCK_API_KEY=""

# Option B: Standard AWS IAM credentials with Amazon Bedrock access
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
AWS_REGION="us-east-1"
# Optional: AWS session token (if using temporary role credentials)
AWS_SESSION_TOKEN=""

# Optional: Bedrock Model ID (defaults to Claude 3.5 Sonnet or Nova/Llama)
# Examples: anthropic.claude-3-5-sonnet-20240620-v1:0, us.anthropic.claude-3-5-sonnet-20241022-v2:0, amazon.nova-micro-v1:0
BEDROCK_MODEL_ID="anthropic.claude-3-5-sonnet-20240620-v1:0"

# Google Gemini API Key:
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# Optional: OpenAI API Key (if using OpenAI models)
OPENAI_API_KEY=""

# ==============================================================================
# Nasiko Agent Orchestrator & Control Plane
# ==============================================================================
# If running Nasiko locally via Docker: `git clone https://github.com/Nasiko-Labs/nasiko.git && docker compose up -d`
# Nasiko server listens on port 8080 by default. If left blank or unset,
# the applet automatically detects and connects to http://localhost:8080,
# while keeping embedded orchestration active as a seamless fallback.
NASIKO_API_URL="http://localhost:8080"

# ==============================================================================
# Database Storage (OPTIONAL - Zero configuration required)
# ==============================================================================
# Built-in embedded storage persists all interview sessions, candidates, reports,
# and evaluations directly into `./data/interview_coach.json`.
# No external database server or connection string is required.
DATABASE_URL="sqlite://./data/interview_coach.db"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# ==============================================================================
# Anakin.io Web Scraping (URL Scraper API)
# ==============================================================================
# Anakin.io provides automated web scraping for job postings and candidate links.
# Free credits / API key can be retrieved from https://anakin.io
ANAKIN_API_KEY=""
ANAKIN_BASE_URL="https://api.anakin.io/v1"

