{
 "schema_version": "compact-tools-eval-v1",
 "purpose": "Own cases for compact-tools prompt tuning (reference time 2026-10-02, Friday, Asia/Kolkata). Reported separately from the public set.",
 "tools": [
  {
   "type": "function",
   "function": {
    "name": "create_calendar_event",
    "description": "Create an event in the user's calendar.",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string",
       "description": "Event title"
      },
      "start": {
       "type": "string",
       "format": "date-time",
       "description": "Start time, ISO 8601"
      },
      "duration_min": {
       "type": "integer",
       "description": "Duration in minutes"
      },
      "attendees": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Attendee emails"
      },
      "visibility": {
       "type": "string",
       "enum": [
        "public",
        "private"
       ]
      }
     },
     "required": [
      "title",
      "start"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "send_email",
    "description": "Send an email from the user's account.",
    "parameters": {
     "type": "object",
     "properties": {
      "to": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Recipient emails"
      },
      "subject": {
       "type": "string",
       "description": "Subject line"
      },
      "body": {
       "type": "string",
       "description": "Plain-text body"
      },
      "cc": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "CC emails"
      }
     },
     "required": [
      "to",
      "subject",
      "body"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "get_weather",
    "description": "Get the current weather for a city.",
    "parameters": {
     "type": "object",
     "properties": {
      "city": {
       "type": "string",
       "description": "City name"
      },
      "unit": {
       "type": "string",
       "enum": [
        "celsius",
        "fahrenheit"
       ]
      }
     },
     "required": [
      "city"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "create_task",
    "description": "Create a task in the team tracker.",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string",
       "description": "Task title"
      },
      "priority": {
       "type": "string",
       "enum": [
        "low",
        "medium",
        "high"
       ]
      },
      "due": {
       "type": "string",
       "description": "Due date",
       "format": "date"
      },
      "tags": {
       "type": "array",
       "items": {
        "type": "string"
       },
       "description": "Labels"
      },
      "assignee": {
       "type": "object",
       "description": "Person responsible",
       "properties": {
        "name": {
         "type": "string"
        },
        "email": {
         "type": "string",
         "format": "email"
        }
       },
       "required": [
        "name"
       ]
      }
     },
     "required": [
      "title",
      "priority"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "search_files",
    "description": "Search project files by text.",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Text to find"
      },
      "max_results": {
       "type": "integer",
       "description": "Maximum number of results"
      },
      "include_hidden": {
       "type": "boolean",
       "description": "Also search hidden files"
      }
     },
     "required": [
      "query"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "set_thermostat",
    "description": "Set the home thermostat.",
    "parameters": {
     "type": "object",
     "properties": {
      "temperature": {
       "type": "number",
       "description": "Target temperature in Celsius"
      },
      "mode": {
       "type": "string",
       "enum": [
        "heat",
        "cool",
        "auto"
       ]
      }
     },
     "required": [
      "temperature"
     ]
    }
   }
  }
 ],
 "cases": [
