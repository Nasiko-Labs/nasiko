 "decoder_cases": [
  {
   "id": "own-dc-001",
   "note": "nested object, split mid-key",
   "tools": [
    "create_task"
   ],
   "chunks": [
    "<<call create_task {\"title\":\"T\",\"priority\":\"high\",\"assignee\":{\"na",
    "me\":\"Dana\"}}",
    ">>"
   ],
   "expected": {
    "calls": [
     {
      "name": "create_task",
      "arguments": {
       "title": "T",
       "priority": "high",
       "assignee": {
        "name": "Dana"
       }
      }
     }
    ]
   }
  },
  {
   "id": "own-dc-002",
   "note": "nested required field missing",
   "tools": [
    "create_task"
   ],
   "chunks": [
    "<<call create_task {\"title\":\"T\",\"priority\":\"high\",\"assignee\":{\"email\":\"d@x.com\"}}>>"
   ],
   "expected": {
    "error": "invalid_arguments"
   }
  },
  {
   "id": "own-dc-003",
   "note": "enum violation inside array item type",
   "tools": [
    "create_task"
   ],
   "chunks": [
    "<<call create_task {\"title\":\"T\",\"priority\":\"urgent\"}>>"
   ],
   "expected": {
    "error": "invalid_arguments"
   }
  },
  {
   "id": "own-dc-004",
   "note": "two calls, text between and after",
   "tools": [
    "get_weather"
   ],
   "chunks": [
    "Checking. <<call get_weather {\"city\":\"A\"}>> and <<call get_weather {\"city\":\"B\"}>> done"
   ],
   "expected": {
    "calls": [
     {
      "name": "get_weather",
      "arguments": {
       "city": "A"
      }
     },
     {
      "name": "get_weather",
      "arguments": {
       "city": "B"
      }
     }
    ]
   }
  },
  {
   "id": "own-dc-005",
