{
  "schema_version": "compact-tools-eval-v1",
  "purpose": "Author-created development cases, separate from the organizer sample and not a held-out accuracy claim.",
  "tools": [
    {"type":"function","function":{"name":"get_weather","description":"Get the current weather for a city. Does not provide forecasts.","parameters":{"type":"object","properties":{"city":{"type":"string","description":"City name"},"units":{"type":"string","enum":["celsius","fahrenheit"],"description":"Temperature units"}},"required":["city","units"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"get_forecast","description":"Get the weather forecast for a city on a specific future date.","parameters":{"type":"object","properties":{"city":{"type":"string"},"date":{"type":"string","format":"date"}},"required":["city","date"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"search_docs","description":"Search documentation using a natural-language query. Returns matching document IDs.","parameters":{"type":"object","properties":{"query":{"type":"string","minLength":1},"limit":{"type":"integer","minimum":1,"maximum":20}},"required":["query"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"get_document","description":"Retrieve a document by its exact document ID. Use search_docs when no ID is known.","parameters":{"type":"object","properties":{"document_id":{"type":"string","minLength":1}},"required":["document_id"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"create_shipment","description":"Create a shipment using the supplied address and item quantities. Never invent missing address fields.","parameters":{"type":"object","properties":{"address":{"type":"object","properties":{"city":{"type":"string"},"postal_code":{"type":"string"},"country":{"type":"string","enum":["IN","US"]}},"required":["city","postal_code","country"],"additionalProperties":false},"items":{"type":"array","minItems":1,"items":{"type":"object","properties":{"sku":{"type":"string"},"quantity":{"type":"integer","minimum":1}},"required":["sku","quantity"],"additionalProperties":false}},"express":{"type":"boolean"},"note":{"type":["string","null"]}},"required":["address","items"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"save_note","description":"Store the user's exact text without editing it.","parameters":{"type":"object","properties":{"text":{"type":"string","description":"Verbatim note text"},"tags":{"type":"array","items":{"type":"string"},"uniqueItems":true}},"required":["text"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"set_volume","description":"Set playback volume to an integer percentage from 0 to 100.","parameters":{"type":"object","properties":{"percent":{"type":"integer","minimum":0,"maximum":100}},"required":["percent"],"additionalProperties":false}}},
    {"type":"function","function":{"name":"echo_value","description":"Echo the supplied string or integer unchanged.","parameters":{"type":"object","properties":{"value":{"anyOf":[{"type":"string"},{"type":"integer"}]}},"required":["value"],"additionalProperties":false}}}
  ],
  "cases": [
    {"id":"dev-weather","tools":["get_weather","get_forecast"],"messages":[{"role":"user","content":"Get the current weather in Pune in celsius."}],"expected":[{"name":"get_weather","arguments":{"city":"Pune","units":"celsius"}}]},
    {"id":"dev-forecast","tools":["get_weather","get_forecast"],"messages":[{"role":"user","content":"Get the weather forecast for Chennai on 2026-10-09."}],"expected":[{"name":"get_forecast","arguments":{"city":"Chennai","date":"2026-10-09"}}]},
    {"id":"dev-search","tools":["search_docs","get_document"],"messages":[{"role":"user","content":"Search documentation for the exact query 'retry configuration', returning at most 3 results."}],"expected":[{"name":"search_docs","arguments":{"query":"retry configuration","limit":3}}]},
    {"id":"dev-document","tools":["search_docs","get_document"],"messages":[{"role":"user","content":"Retrieve document doc-123 by its ID."}],"expected":[{"name":"get_document","arguments":{"document_id":"doc-123"}}]},
    {"id":"dev-nested","tools":["create_shipment","save_note"],"messages":[{"role":"user","content":"Create an express shipment to Pune, postal code 411001, country IN, containing 2 units of SKU ABC and 1 unit of SKU XYZ. Do not add a note."}],"expected":[{"name":"create_shipment","arguments":{"address":{"city":"Pune","postal_code":"411001","country":"IN"},"items":[{"sku":"ABC","quantity":2},{"sku":"XYZ","quantity":1}],"express":true}}]},
    {"id":"dev-null","tools":["create_shipment","save_note"],"messages":[{"role":"user","content":"Create a shipment to Boston, postal code 02108, country US, with 1 unit of SKU PEN. Set express to false and note explicitly to null."}],"expected":[{"name":"create_shipment","arguments":{"address":{"city":"Boston","postal_code":"02108","country":"US"},"items":[{"sku":"PEN","quantity":1}],"express":false,"note":null}}]},
    {"id":"dev-delimiters","tools":["save_note","search_docs"],"messages":[{"role":"user","content":"Save this exact note text: a >> b; literal <<call marker. Tag it parser."}],"expected":[{"name":"save_note","arguments":{"text":"a >> b; literal <<call marker.","tags":["parser"]}}]},
    {"id":"dev-unicode","tools":["save_note","search_docs"],"messages":[{"role":"user","content":"Save this exact note with no tags: नमस्ते 🌏"}],"expected":[{"name":"save_note","arguments":{"text":"नमस्ते 🌏"}}]},
    {"id":"dev-zero","tools":["set_volume","save_note"],"messages":[{"role":"user","content":"Set playback volume to 0 percent."}],"expected":[{"name":"set_volume","arguments":{"percent":0}}]},
    {"id":"dev-multiple","tools":["get_weather","get_forecast","set_volume"],"messages":[{"role":"user","content":"First get the current weather in Delhi in fahrenheit, then set playback volume to 25 percent."}],"expected":[{"name":"get_weather","arguments":{"city":"Delhi","units":"fahrenheit"}},{"name":"set_volume","arguments":{"percent":25}}]},
    {"id":"dev-no-call","tools":["get_weather","get_forecast"],"messages":[{"role":"user","content":"What is 6 multiplied by 7?"}],"expected":[]},
    {"id":"dev-missing","tools":["create_shipment","save_note"],"messages":[{"role":"user","content":"I want a shipment, but I haven't decided on the address or items yet. Ask me what information you need."}],"expected":[]},
    {"id":"dev-bypass","tools":["echo_value"],"messages":[{"role":"user","content":"Echo the integer 42."}],"expected":[{"name":"echo_value","arguments":{"value":42}}]}
  ],
  "decoder_cases": [
    {"id":"dev-dc-nested","tools":["create_shipment"],"chunks":["<<call create_shipment {\"address\":{\"city\":\"Pune\",\"postal_code\":\"411001\",\"country\":\"IN\"},\"items\":[{\"sku\":\"ABC\",\"quantity\":2}]}",">",">"],"expected":{"calls":[{"name":"create_shipment","arguments":{"address":{"city":"Pune","postal_code":"411001","country":"IN"},"items":[{"sku":"ABC","quantity":2}]}}]}},
    {"id":"dev-dc-type","tools":["set_volume"],"chunks":["<<call set_volume {\"percent\":\"50\"}>>"],"expected":{"error":"invalid_arguments"}},
    {"id":"dev-dc-bound","tools":["set_volume"],"chunks":["<<call set_volume {\"percent\":101}>>"],"expected":{"error":"invalid_arguments"}},
    {"id":"dev-dc-duplicate","tools":["set_volume"],"chunks":["<<call set_volume {\"percent\":20,\"percent\":30}>>"],"expected":{"error":"invalid_arguments"}},
    {"id":"dev-dc-atomic","tools":["set_volume"],"chunks":["<<call set_volume {\"percent\":20}>>", "<<call missing {}>>"],"expected":{"error":"unknown_tool"}},
    {"id":"dev-dc-truncated","tools":["set_volume"],"chunks":["<<call set_volume {\"percent\":20}>"],"expected":{"error":"incomplete_call"}},
    {"id":"dev-dc-date","tools":["get_forecast"],"chunks":["<<call get_forecast {\"city\":\"Pune\",\"date\":\"2026-99-99\"}>>"],"expected":{"error":"invalid_arguments"}},
    {"id":"dev-dc-plain","tools":["get_weather"],"chunks":["The answer ","is 42."],"expected":{"calls":[]}}
  ]
}
