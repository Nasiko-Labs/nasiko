{
  "schema_version": "compact-tools-eval@v1-sample",
  "purpose": "Public sample set for compact tool schemas screening",
  "tools": [
    {
      "type": "function",
      "function": {
        "name": "create_calendar_event",
        "description": "Create an event in the user's calendar.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": { "type": "string", "description": "Event title" },
            "start": { "type": "string", "format": "date-time", "description": "Start time, ISO 8601" },
            "duration_min": { "type": "integer", "description": "Duration in minutes" },
            "attendees": { "type": "array", "items": { "type": "string" }, "description": "Attendee emails" },
            "visibility": { "type": "string", "enum": ["public", "private"] }
          },
          "required": ["title", "start"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "send_email",
        "description": "Send an email to one or more recipients.",
        "parameters": {
          "type": "object",
          "properties": {
            "to": { "type": "array", "items": { "type": "string" }, "description": "Recipient email addresses" },
            "subject": { "type": "string", "description": "Email subject line" },
            "body": { "type": "string", "description": "Email body content" }
          },
          "required": ["to", "subject"]
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "unsupported_search",
        "description": "Search with unsupported oneOf schema construct.",
        "parameters": {
          "type": "object",
          "properties": {
            "query": {
              "oneOf": [
                { "type": "string" },
                { "type": "array", "items": { "type": "string" } }
              ]
            }
          },
          "required": ["query"]
        }
      }
    }
  ],
  "cases": [
    {
      "id": "ct-001",
      "tools": ["create_calendar_event", "send_email"],
      "messages": [
        { "role": "user", "content": "Book a design review Monday 3pm IST with riya@example.com" }
      ],
      "expected": [
        {
          "name": "create_calendar_event",
          "arguments": {
            "title": "Design review",
            "start": "2026-10-05T15:00:00+05:30",
            "attendees": ["riya@example.com"]
          }
        }
      ]
    },
    {
      "id": "ct-002",
      "tools": ["create_calendar_event", "send_email"],
      "messages": [
        { "role": "user", "content": "Email sam@example.com that the build is green, and add a private 30 min retro tomorrow 10am IST" }
      ],
      "expected": [
        {
          "name": "send_email",
          "arguments": {
            "to": ["sam@example.com"],
            "subject": "Build status",
            "body": "The build is green."
          }
        },
        {
          "name": "create_calendar_event",
          "arguments": {
            "title": "Retro",
            "start": "2026-10-04T10:00:00+05:30",
            "duration_min": 30,
            "visibility": "private"
          }
        }
      ],
      "match": {
        "free_text_fields": ["subject", "body", "title"]
      }
    },
    {
      "id": "ct-003",
      "tools": ["create_calendar_event"],
      "messages": [
        { "role": "user", "content": "What's the weather?" }
      ],
      "expected": []
    },
    {
      "id": "ct-004-unsupported",
      "tools": ["unsupported_search"],
      "messages": [
        { "role": "user", "content": "Find docs for rust" }
      ],
      "expected": [
        {
          "name": "unsupported_search",
          "arguments": {
            "query": "rust"
          }
        }
      ]
    }
  ],
  "decoder_cases": [
    {
      "id": "dc-002",
      "note": "marker split across stream chunks",
      "tools": ["create_calendar_event"],
      "chunks": [
        "<<ca",
        "ll create_calendar_event {\"title\":\"Ret",
        "ro\",\"start\":\"2026-10-04T10:00:00+05:30\"}>",
        ">"
      ],
      "expected": {
        "calls": [
          {
            "name": "create_calendar_event",
            "arguments": {
              "title": "Retro",
              "start": "2026-10-04T10:00:00+05:30"
            }
          }
        ]
      }
    },
    {
      "id": "dc-003-error-unknown",
      "note": "unknown tool error case",
      "tools": ["create_calendar_event"],
      "chunks": [
        "<<call delete_database {\"all\": true}>>"
      ],
      "expected": {
        "error": "unknown_tool"
      }
    },
    {
      "id": "dc-004-error-missing-arg",
      "note": "missing required field error case",
      "tools": ["create_calendar_event"],
      "chunks": [
        "<<call create_calendar_event {\"duration_min\": 30}>>"
      ],
      "expected": {
        "error": "invalid_arguments"
      }
    }
  ]
}
