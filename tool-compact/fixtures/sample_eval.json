[
  {
    "name": "simple_search",
    "tools": [
      {
        "type": "function",
        "function": {
          "name": "search_web",
          "description": "Search the web for information.",
          "parameters": {
            "type": "object",
            "properties": {
              "query": { "type": "string" }
            },
            "required": ["query"]
          }
        }
      }
