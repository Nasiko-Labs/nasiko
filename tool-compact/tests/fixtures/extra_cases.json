{
 "schema_version": "compact-tools-eval-v1",
 "purpose": "OUR OWN extra cases. Same schema as the public sample; report separately; never used to tune.",
 "tools": [
  {
   "type": "function",
   "function": {
    "name": "book_hotel",
    "description": "Reserve hotel rooms.",
    "parameters": {
     "type": "object",
     "properties": {
      "guest": {
       "type": "object",
       "properties": {
        "name": {
         "type": "string",
         "description": "Full name"
        },
        "age": {
         "type": "integer"
        }
       },
       "required": [
        "name"
       ],
       "description": "Who is staying"
      },
      "rooms": {
       "type": "array",
       "items": {
        "type": "object",
        "properties": {
         "beds": {
          "type": "number"
         },
         "smoking": {
          "type": "boolean"
         }
        },
        "required": [
         "beds"
        ]
       }
      },
      "checkin": {
       "type": "string",
       "format": "date-time"
      },
      "tier": {
       "type": "string",
       "enum": [
        "standard",
        "deluxe"
       ]
      }
     },
     "required": [
      "guest",
      "checkin"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "search_files",
    "description": "Search the user's files.",
    "parameters": {
     "type": "object",
     "properties": {
      "query": {
       "type": "string",
       "description": "Search text"
      },
      "paths": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "max_results": {
       "type": "integer"
      },
      "sort": {
       "type": "string",
       "enum": [
        "name",
        "date"
       ]
      }
     },
     "required": [
      "query"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "set_reminder",
    "description": "Create a reminder.",
    "parameters": {
     "type": "object",
     "properties": {
      "message": {
       "type": "string",
       "description": "What to remind"
      },
      "when": {
       "type": "string",
       "format": "date-time"
      },
      "repeat": {
       "type": "string",
       "enum": [
        "daily",
        "weekly"
       ]
      }
     },
     "required": [
      "message",
      "when"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "create_ticket",
    "description": "Open a ticket in the tracker.",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "labels": {
       "type": "array",
       "items": {
        "type": "string"
       }
      },
      "priority": {
       "type": "string",
       "enum": [
        "low",
        "high",
        "urgent"
       ]
      },
      "assignee": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "priority"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "notes_add",
    "description": "Add a note.",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "body": {
       "type": "string"
      }
     },
     "required": [
      "title",
      "body"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "mail_draft",
    "description": "Draft an email.",
    "parameters": {
     "type": "object",
     "properties": {
      "title": {
       "type": "string"
      },
      "body": {
       "type": "string"
      }
     },
     "required": [
      "body"
     ]
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "lookup_ref",
    "description": "Uses a $ref.",
    "parameters": {
     "type": "object",
     "properties": {
      "item": {
       "$ref": "#/$defs/item"
      }
     },
     "$defs": {
      "item": {
       "type": "string"
      }
     }
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "pick_one",
    "description": "Uses oneOf.",
    "parameters": {
     "type": "object",
     "properties": {
      "choice": {
       "oneOf": [
        {
         "type": "string"
        },
        {
         "type": "integer"
        }
       ]
      }
     }
    }
   }
  },
  {
   "type": "function",
   "function": {
    "name": "resize",
    "description": "Uses a numeric bound.",
    "parameters": {
     "type": "object",
     "properties": {
      "width": {
       "type": "integer",
       "minimum": 1,
       "maximum": 4096
      }
     },
     "required": [
      "width"
     ]
    }
   }
  }
 ],
 "cases": [
  {
   "id": "xt-001",
   "tools": [
    "book_hotel",
    "search_files"
   ],
   "messages": [
    {
     "role": "user",
     "content": "Book a deluxe room for Asha Rao, age 34, two beds, check-in 2026-10-10 14:00 IST"
    }
   ],
   "expected": [
    {
     "name": "book_hotel",
     "arguments": {
      "guest": {
       "name": "Asha Rao",
       "age": 34
      },
      "rooms": [
       {
        "beds": 2
       }
      ],
      "checkin": "2026-10-10T14:00:00+05:30",
      "tier": "deluxe"
     }
    }
   ],
   "match": {
    "free_text_fields": [
     "guest"
    ]
   }
  },
