# ─────────────────────────────────────────────────────────────────────────────
#  Nasiko — docker compose quick start
#
#      cp .env.example .env              # then edit
#      docker compose up -d
#
#  This file covers the docker-compose path only. compose already sets the
#  connection URLs, the OTLP endpoints and the in-network service URLs for you,
#  so those URLs do not need entries here. Compose's `environment` values
#  override this file. Replace the public demo secrets below before first boot;
#  use a different generated value for each signing/encryption key.
#
#  → For the COMPLETE annotated list of every variable the server reads
#    (~120 of them: flow limits, timeouts, the LLM router, token compression,
#    MCP, observability, allowlists), see `server/.env.example`. Every key
#    there also works here — this file is the short path, not a subset of the
#    server's behaviour.
#
#  If you are running from source instead (`just run` / `cargo run`), use
#  `server/.env.example` → `server/.env`. That is the file `just run` sources.
#
#  NEVER commit .env (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────

# ═══════════════════════════════════════════════════════════════════════════
# 1) SECRETS, FIRST LOGIN & STORAGE — replace demo secrets before first boot
# ═══════════════════════════════════════════════════════════════════════════

# AES-256-GCM key encrypting agent secrets at rest. Exactly 32 bytes,
# base64-encoded — validated at startup.  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=kmd9Ic4cgD9YYE/owDL3QSzpKI/BZ3pmVZQ67X+eABc=

# Signs user session JWTs.  openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# The admin account created on first boot.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Object storage — must match the `rustfs` service in docker-compose.yml.
# (compose sets S3_ENDPOINT itself.)
S3_BUCKET=nasiko
S3_ACCESS_KEY=nasiko
S3_SECRET_KEY=nasiko123
S3_REGION=us-east-1

# ═══════════════════════════════════════════════════════════════════════════
# 2) RUNTIME
# ═══════════════════════════════════════════════════════════════════════════

# "docker" deploys agents as containers — the right value for this stack.
AGENT_RUNTIME=docker

# Logging verbosity (Rust tracing filter).
RUST_LOG=info

# ═══════════════════════════════════════════════════════════════════════════
# 3) LLM — provider credentials and local coding-agent router authentication
# ═══════════════════════════════════════════════════════════════════════════

# Provider key for the default OpenAI-backed routing engine and the LLM
# gateway's platform-key fallback. Replace it with a real key for that setup.
# A local coding agent using a custom LLM config can instead use the provider
# credentials stored in that config/user secret or the registered custom provider.
# With gateway wiring enabled, deployed agents receive an identity JWT, not this key.
OPENAI_API_KEY=sk-your-openai-api-key

# OpenAI-compatible endpoint used by the routing engine/direct-provider path.
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
# The LLM gateway's built-in OpenAI provider uses a SEPARATE setting. If you
# redirect both paths to a compatible endpoint, set both URL variables.
# A registered custom provider uses its stored endpoint instead of these defaults.
# OPENAI_API_BASE=https://api.openai.com/v1

# REQUIRED for local coding-agent routing: nasiko connect claude|codex|opencode
# --config <name>, including custom LLM configs. Signs agent identity tokens;
# this is NOT the provider API key or JWT_SECRET (user login). Generate a
# separate value: openssl rand -base64 48
# Missing/empty: /api/agents/{id}/llm-token returns 503 and gateway auth fails.
# The server can still boot; container deployment skips gateway wiring.
# Keep this secret on the server only — local clients obtain short-lived JWTs.
AGENT_JWT_SECRET=dev-agent-secret-change-me

# Opt-in compact tool schemas (nasiko-tool-compact). Default off = native tools unchanged.
# TOKEN_TOOL_COMPACT=false
# TOKEN_TOOL_COMPACT=true

# ═══════════════════════════════════════════════════════════════════════════
# 4) MCP GATEWAY  — optional; agents work without it
# ═══════════════════════════════════════════════════════════════════════════

# Composio integration. Unset = Composio disabled; generic and uploaded MCP
# servers still work without it.
# COMPOSIO_API_KEY=ak_your-composio-api-key

# Comma-separated Composio toolkits auto-registered at boot. NO-OP without
# COMPOSIO_API_KEY above — setting it alone logs a warning every boot and does
# nothing further, which is harmless if you do not need Composio.
# SEED_TOOLKITS=gmail,slack,notion,github,googlecalendar

# OAuth redirect bases, opened in the USER'S OWN BROWSER — so these are
# localhost URLs even though the server runs in a container.
MCP_OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/mcp
COMPOSIO_CALLBACK_BASE_URL=http://localhost:8080/api/mcp

# ═══════════════════════════════════════════════════════════════════════════
# 5) STARTUP & SECURITY
# ═══════════════════════════════════════════════════════════════════════════

# Space-separated container images auto-deployed at boot. Read ONCE at startup;
# changing it needs a restart.
# SEED_AGENTS=

# OCI registry hosts accepted by /api/catalog/import/registry.
# EMPTY REJECTS ALL registry imports — the safe default. E.g. ghcr.io,quay.io
REGISTRY_IMPORT_ALLOWED_HOSTS=registry.nasiko.dev

# Git hosts accepted for source-clone deploys.
# GIT_CLONE_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org

# Cross-origin browser access (comma-separated). Empty = same-origin only, which
# is correct unless you run the UI on a separate dev server.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# ═══════════════════════════════════════════════════════════════════════════
# 6) GITHUB OAUTH  — optional, enables import-from-GitHub / clone flows
# ═══════════════════════════════════════════════════════════════════════════
# Create an OAuth App at https://github.com/settings/developers.
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback
