# ─────────────────────────────────────────────────────────────────────────────
#  Nasiko — environment configuration
#
#  Copy this file to .env, edit, then run:
#      docker compose up -d          (Docker-only quick start)
#      just run                      (source / Rust developer setup)
#
#  NEVER commit .env to git (it is gitignored).
#  Only the settings below need real values — the rest have safe defaults.
# ─────────────────────────────────────────────────────────────────────────────
#
#  ┌── HOW TO READ THIS FILE ──────────────────────────────────────────────┐
#  │  • "Required"  → the server will fail to start if missing/invalid.    │
#  │  • "Optional"  → leave commented out to use the default.              │
#  │  • Credential  → replace the placeholder with your real secret key.   │
#  └───────────────────────────────────────────────────────────────────────┘

# ═══════════════════════════════════════════════════════════════════════════
# 1) REQUIRED  — everything from here up must be set
# ═══════════════════════════════════════════════════════════════════════════

# --- Security keys ----------------------------------------------------------

# AES-256-GCM key used to encrypt agent secrets at rest.
# Generate one with:  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=REPLACE_WITH_YOUR_OWN_KEY_run_openssl_rand_-base64_32

# JWT secret used to sign user/auth tokens. Generate one with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# Shared secret the LLM Router uses to mint short-lived agent-identity JWTs.
# Generate one with:  openssl rand -base64 48
# AGENT_JWT_SECRET=dev-secret-change-in-prod

# --- Bootstrap admin ---------------------------------------------------------

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Optional: email shown on the admin account.
ADMIN_EMAIL=admin@example.com

# --- Object storage (embeds the OCI registry) --------------------------------
# These must EXACTLY match the `rustfs` service in docker-compose.yml.
S3_BUCKET=nasiko
S3_ACCESS_KEY=nasiko
S3_SECRET_KEY=nasiko123
S3_REGION=us-east-1

# --- Runtime -----------------------------------------------------------------

# Container runtime used to deploy agents. "docker" for the compose stack.
AGENT_RUNTIME=docker

# Logging verbosity (Rust tracing filter). "info" is a good default.
RUST_LOG=info
# ═══════════════════════════════════════════════════════════════════════════
# 2) LLM  — used by the routing engine, orchestrator, and deployed agents
# ═══════════════════════════════════════════════════════════════════════════

# OpenAI-compatible API key, injected into every deployed agent automatically.
# (credential — replace with your real key)
OPENAI_API_KEY=sk-your-openai-api-key

# Override the API base URL (Azure OpenAI, a local proxy, a gateway, etc.)
OPENAI_BASE_URL=https://api.openai.com/v1

# Default model used for agents and tool-description fallback.
OPENAI_MODEL=gpt-4o-mini

# Model used by the MCP connector/tool-description LLM fallback.
# Defaults to gpt-4o-mini if unset.
# MCP_DESCRIPTION_MODEL=gpt-4o-mini

# Models used by the routing engine (shortlist / rerank / select).
# ROUTER_MODEL=
# EMBEDDING_MODEL=

# ─── LLM Router (built into the server — routes agent LLM calls) ─────────────
# Base URL deployed agents use to reach the LLM Router.
# "http://localhost:8080" for a host-run single-node server.
# LLM_GATEWAY_BASE_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════
# 3) FLOW GUARDS  — Redis-backed limits that stop runaway agent loops
# ═══════════════════════════════════════════════════════════════════════════
# FLOW_MAX_DEPTH=
# FLOW_MAX_FAN_OUT=
# FLOW_MAX_TOKENS=
# FLOW_TIMEOUT_SECS=

# ═══════════════════════════════════════════════════════════════════════════
# 4) SEED AGENTS  — containers auto-deployed at startup
# ═══════════════════════════════════════════════════════════════════════════
# Space-separated container images to deploy on boot.
# SEED_AGENTS=

# ═══════════════════════════════════════════════════════════════════════════
# 5) MCP GATEWAY  — merged tool access for agents (Composio + custom MCP)
# ═══════════════════════════════════════════════════════════════════════════

# Composio platform API key. Unset = Composio disabled (custom MCP servers
# still work without it). (credential — replace with your real key)
# COMPOSIO_API_KEY=ak_your-composio-api-key

# Composio backend URL. Defaults to https://backend.composio.dev
# COMPOSIO_BASE_URL=https://backend.composio.dev

# HMAC secret to verify inbound Composio webhooks. Unset = signature check
# skipped (dev only).
# COMPOSIO_WEBHOOK_SECRET=

# Comma-separated Composio toolkits to auto-register at boot.
# Examples: gmail, slack, googlecalendar, github, notion, jira, linear, asana,
# trello, discord, dropbox, salesforce, hubspot, zendesk, intercom, stripe,
# airtable, clickup, monday, gitlab, pagerduty, sentry, confluence, bitbucket,
# googledrive, googlesheets. No-op without COMPOSIO_API_KEY.
SEED_TOOLKITS=gmail,slack,notion,github,googlecalendar

# Public URL of the MCP gateway, injected into every deployed agent as
# MCP_GATEWAY_URL. When running via docker compose this is set for you
# (http://server:8080/api/mcp). For a host-run server + Docker-based agents:
# MCP_GATEWAY_PUBLIC_URL=http://host.docker.internal:8080/api/mcp

# OAuth redirect base for the MCP gateway, opened in the USER'S OWN BROWSER.
# Used for generic-connector OAuth 2.1 redirects and Composio connect.
MCP_OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/mcp
COMPOSIO_CALLBACK_BASE_URL=http://localhost:8080/api/mcp

# ─── Redis-cached MCP TTLs (seconds — safe to leave at defaults) ─────────────
# MCP_SESSION_TTL_SECONDS=300
# MCP_PERM_CACHE_TTL_SECONDS=30
# MCP_MANIFEST_TTL_SECONDS=300
# MCP_TOOLCOUNT_TTL_SECONDS=3600

# ─── Uploaded MCP-server build/deploy settings ───────────────────────────────
# MCP_UPLOAD_MAX_BYTES=52428800        # 50 MiB
# MCP_UPLOAD_DEFAULT_PORT=8080         # port the uploaded container must bind
# MCP_SERVERS_NETWORK=nasiko-mcp-servers-net
# MCP_UPLOAD_MAX_REPLICAS=1
# ═══════════════════════════════════════════════════════════════════════════
# 6) GITHUB OAuth  — optional, enables import-from-GitHub / clone flows
# ═══════════════════════════════════════════════════════════════════════════
# Create an OAuth App at https://github.com/settings/developers and use the
# client id/secret here. (credentials — replace with real values)
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# ═══════════════════════════════════════════════════════════════════════════
# 7) OBSERVABILITY  — required for full tracing + log metrics
#    (when running via docker compose these are set for you)
# ═══════════════════════════════════════════════════════════════════════════
# TEMPO_URL=http://localhost:3200
# LOKI_URL=http://localhost:3100
# OTEL_COLLECTOR_ENDPOINT=http://172.17.0.1:4317
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
# OTEL_SERVICE_NAME=nasiko-cp
# OTEL_SAMPLE_RATIO=1.0

# ═══════════════════════════════════════════════════════════════════════════
# 8) SOURCE-RUN ONLY  — connection URLs (NOT used by docker compose)
#    Only required when running the server from source (just run / cargo run),
#    where docker-compose.yml does NOT set these for you.
# ═══════════════════════════════════════════════════════════════════════════
# DATABASE_URL=postgres://nasiko:nasiko@localhost:5432/nasiko_dev
# REDIS_URL=redis://localhost:6379
# S3_ENDPOINT=http://localhost:9000
# DOCKER_AGENT_NETWORK=
# OCI_REGISTRY_HOST=
# APP_BASE_URL=

# ═══════════════════════════════════════════════════════════════════════════
# 9) ADVANCED / MISC
# ═══════════════════════════════════════════════════════════════════════════

# Comma-separated OCI registry hosts allowed for `/api/catalog/import/registry`.
# Empty = reject all registry imports (safest default). E.g. ghcr.io,quay.io
REGISTRY_IMPORT_ALLOWED_HOSTS=registry.nasiko.dev

# Comma-separated git hosts allowed for source-clone deploys.
# Defaults to github.com,gitlab.com,bitbucket.org
# GIT_CLONE_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org

# Cross-origin browser access (comma-separated). Empty = same-origin only.
# Only needed for a split dev server or an external integration.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server bind address (default 0.0.0.0:8080).
# CP_BIND=0.0.0.0:8080
