# ─────────────────────────────────────────────────────────────────────────────
#  Nasiko — server environment configuration (source-run)
#
#  Copy this file to server/.env and edit, then run from the repo root:
#      cargo run -p nasiko-server        (or: just run)
#
#  This template is for running the server FROM SOURCE on the host.
#  When you run the full stack via `docker compose`, docker-compose.yml sets
#  the connection URLs for you — you only need the values here.
#
#  NEVER commit server/.env to git (it is gitignored).
# ─────────────────────────────────────────────────────────────────────────────
#
#  HOW TO READ THIS FILE
#  • "Required"  → the server will fail to start if missing/invalid.
#  • "Optional"  → leave commented out to use the built-in default.
#  • Credential   → replace the placeholder with your real secret key.

# ═══════════════════════════════════════════════════════════════════════════
# 1) SECURITY KEYS  — all required
# ═══════════════════════════════════════════════════════════════════════════

# AES-256-GCM key used to encrypt agent secrets at rest.
# Generate one with:  openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=kmd9Ic4cgD9YYE/owDL3QSzpKI/BZ3pmVZQ67X+eABc=

# JWT secret used to sign user/auth tokens. Generate with: openssl rand -base64 48
JWT_SECRET=dev-secret-change-me

# Shared secret the LLM Router uses to mint short-lived agent-identity JWTs.
# Generate with:  openssl rand -base64 48
# AGENT_JWT_SECRET=dev-secret-change-in-prod

# ═══════════════════════════════════════════════════════════════════════════
# 2) BOOTSTRAP ADMIN  — created on first boot
# ═══════════════════════════════════════════════════════════════════════════

ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
# Optional: email shown on the admin account.
ADMIN_EMAIL=admin@example.com

# ═══════════════════════════════════════════════════════════════════════════
# 3) CONNECTION URLs  — required when running from source
#    (docker compose sets these automatically — not used in that mode)
# ═══════════════════════════════════════════════════════════════════════════
# Postgres. Adjust the credentials/user/db to match your local Postgres.
DATABASE_URL=postgres://nasiko:nasiko@localhost:5432/nasiko_dev

# Redis.
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (S3_ENDPOINT is NOT needed in docker compose mode).
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nasiko
S3_ACCESS_KEY=nasiko
S3_SECRET_KEY=nasiko123
S3_REGION=us-east-1

# Container runtime used to deploy agents.
#   local  → run agents on the host (source/dev)
#   docker → deploy agents as containers (compose / production)
AGENT_RUNTIME=local

# Docker network name used to reach deployed agent containers for proxying.
# Leave UNSET when running the server on the host. Set to the compose network
# name when the server itself runs in Docker.
# DOCKER_AGENT_NETWORK=

# Comma-separated list of seed agents (owner/name) deployed at startup — optional.
SEED_AGENTS=

# Logging verbosity (Rust tracing filter). "info" is a good default.
RUST_LOG=info

# ═══════════════════════════════════════════════════════════════════════════
# 4) LLM  — used by routing engine, orchestrator, and deployed agents
# ═══════════════════════════════════════════════════════════════════════════

# OpenAI-compatible API key, injected into every deployed agent automatically.
# (credential — replace with your real key)
# OPENAI_API_KEY=sk-...

# Override the API base URL (Azure OpenAI, a local proxy, a gateway, etc.)
# OPENAI_BASE_URL=https://api.openai.com/v1

# Default model used for agents and tool-description fallback.
# OPENAI_MODEL=gpt-4o-mini

# Model used by the MCP connector/tool-description LLM fallback.
# Defaults to gpt-4o-mini if unset.
# MCP_DESCRIPTION_MODEL=gpt-4o-mini

# ─── LLM Router (built into the server — routes agent LLM calls) ────────────
# Base URL deployed agents use to reach the LLM Router.
# "http://localhost:8080" for a host-run single-node server.
# LLM_GATEWAY_BASE_URL=http://localhost:8080

# ═══════════════════════════════════════════════════════════════════════════
# 5) OBSERVABILITY  — optional; requires the docker-compose otel stack running
# ═══════════════════════════════════════════════════════════════════════════
# TEMPO_URL=http://localhost:3200
# LOKI_URL=http://localhost:3100

# OTLP endpoint used BY AGENT CONTAINERS to reach the collector.
# OTEL_COLLECTOR_ENDPOINT=http://172.17.0.1:4317

# Transport for agent OTLP export — must match the collector port above
# (4317 = grpc, 4318 = http/protobuf).
# OTEL_EXPORTER_OTLP_PROTOCOL=grpc

# OTLP endpoint used BY THE SERVER to reach the collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# OTEL_SERVICE_NAME=nasiko-cp
# OTEL_SAMPLE_RATIO=1.0

# ═══════════════════════════════════════════════════════════════════════════
# 6) MCP GATEWAY  — optional; everything here has a working default
# ═══════════════════════════════════════════════════════════════════════════

# Composio platform integration — unset = "Composio disabled". Generic
# (external_url / uploaded_build) MCP servers still work without it.
# COMPOSIO_API_KEY=ak_...
# COMPOSIO_BASE_URL=https://backend.composio.dev

# HMAC secret to verify inbound Composio webhooks. Unset = signature check
# skipped (dev only).
# COMPOSIO_WEBHOOK_SECRET=

# Comma-separated Composio toolkit names to auto-register at boot. These 26
# ship with curated display metadata (logo + description):
#   slack gmail github notion jira linear asana trello discord dropbox
#   salesforce hubspot zendesk intercom stripe airtable clickup monday
#   gitlab pagerduty sentry confluence bitbucket googlecalendar googledrive
#   googlesheets
#
# NO-OP without COMPOSIO_API_KEY set above — uncommenting this alone logs a
# "cannot register Composio toolkits without an API key" warning at boot and
# does nothing further.
# SEED_TOOLKITS=gmail,calendar,slack,notion,github,googlecalendar

# Public URL of the MCP gateway, injected into every deployed agent's env as
# MCP_GATEWAY_URL. For a host-run server + Docker-based agents:
# MCP_GATEWAY_PUBLIC_URL=http://host.docker.internal:8080/api/mcp

# OAuth redirect base for the MCP gateway, opened in the USER'S OWN BROWSER.
# Used for generic-connector OAuth 2.1 redirects and Composio connect.
# MCP_OAUTH_REDIRECT_BASE_URL=http://localhost:8080/api/mcp
# COMPOSIO_CALLBACK_BASE_URL=http://localhost:8080/api/mcp

# Redis-cached TTLs (seconds — safe to leave at defaults for local dev).
# MCP_SESSION_TTL_SECONDS=300
# MCP_PERM_CACHE_TTL_SECONDS=30
# MCP_MANIFEST_TTL_SECONDS=300
# MCP_TOOLCOUNT_TTL_SECONDS=3600

# "Upload your own MCP server" (source_kind=uploaded_build) build/deploy settings.
# MCP_UPLOAD_MAX_BYTES=52428800          # 50 MiB
# MCP_UPLOAD_DEFAULT_PORT=8080           # port the uploaded container must bind via $PORT
# MCP_SERVERS_NETWORK=nasiko-mcp-servers-net
# MCP_UPLOAD_MAX_REPLICAS=1

# ═══════════════════════════════════════════════════════════════════════════
# 7) GITHUB OAUTH  — optional, enables import-from-GitHub / clone flows
# ═══════════════════════════════════════════════════════════════════════════
# Create an OAuth App at https://github.com/settings/developers and use the
# client id/secret here. (credentials — replace with real values)
# GITHUB_CLIENT_ID=your-github-oauth-client-id
# GITHUB_CLIENT_SECRET=your-github-oauth-client-secret
# GITHUB_CALLBACK_URL=http://localhost:8080/api/auth/github/callback

# ═══════════════════════════════════════════════════════════════════════════
# 8) ADVANCED / MISC
# ═══════════════════════════════════════════════════════════════════════════

# Comma-separated OCI registry hosts allowed for `/api/catalog/import/registry`.
# Empty = reject all registry imports (safest default).
# REGISTRY_IMPORT_ALLOWED_HOSTS=registry.nasiko.dev

# Comma-separated git hosts allowed for source-clone deploys.
# Defaults to github.com,gitlab.com,bitbucket.org
# GIT_CLONE_ALLOWED_HOSTS=github.com,gitlab.com,bitbucket.org

# Cross-origin browser access (comma-separated). Empty = same-origin only.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Server bind address (default 0.0.0.0:8080).
# CP_BIND=0.0.0.0:8080

# Public base URL / OCI registry host / app URL (override auto-detection).
# APP_BASE_URL=
# OCI_REGISTRY_HOST=