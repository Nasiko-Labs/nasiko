# LLM (passed to seed agents as container env vars)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini
# Model for the MCP connector/tool description LLM fallback — only called
# when a description couldn't be fetched from the connector's native source.
# Defaults to gpt-4o-mini if unset.
# MCP_DESCRIPTION_MODEL="gpt-4o-mini"

# RUST_LOG=info

# # Observability (requires docker-compose.infra.yml otel stack running)
# TEMPO_URL=http://localhost:3200
# LOKI_URL=http://localhost:3100
# OTEL_COLLECTOR_ENDPOINT=http://172.17.0.1:4317   (grpc; use :4318 with http/protobuf)

DATABASE_URL=postgres://nasiko:nasiko@localhost:5432/nasiko_dev
REDIS_URL=redis://localhost:6379
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=nasiko
S3_ACCESS_KEY=nasiko
S3_SECRET_KEY=nasiko123
S3_REGION=us-east-1
AGENT_RUNTIME=local
# Base64-encoded 32-byte AES-256-GCM key. Generate with: openssl rand -base64 32
SECRETS_ENCRYPTION_KEY=kmd9Ic4cgD9YYE/owDL3QSzpKI/BZ3pmVZQ67X+eABc=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
JWT_SECRET=dev-secret-change-me
SEED_AGENTS=

RUST_LOG=info

# Cross-origin browser access — comma-separated, empty (default) allows none.
# Only needed for a split dev server (UI on a different port) or an external
# integration; the UI is served same-origin by this binary normally.
# CORS_ALLOWED_ORIGINS=http://localhost:5173

# Observability (requires docker-compose.infra.yml otel stack running)
TEMPO_URL=http://localhost:3200
LOKI_URL=http://localhost:3100
# NOTE: deliberately leave DOCKER_AGENT_NETWORK unset — this server runs on
# the host, not inside Docker, so ContainerRuntime::endpoint() must keep
# returning the host-published port (localhost:<port>) for the agent proxy
# to reach agents. Agents land on the default "bridge" network, whose
# container DNS names don't resolve for them either, so OTEL_COLLECTOR_ENDPOINT
# below uses the bridge gateway IP (ports are published on all host
# interfaces, so this reaches the collector).
OTEL_COLLECTOR_ENDPOINT=http://172.17.0.1:4317
# Transport for agent OTLP export — must match the collector port above
# (4317 = grpc, 4318 = http/protobuf).
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# ─── MCP Gateway ──────────────────────────────────────────────────────────────
# Everything below has a working default (see oss/config/src/lib.rs) — you only
# need to set these if you're testing the specific feature they control.

# Composio platform integration — unset means "Composio disabled", generic
# (external_url / uploaded_build) MCP servers still work fine without it.
# COMPOSIO_API_KEY=ak_...
# COMPOSIO_BASE_URL=https://backend.composio.dev
# HMAC secret to verify inbound Composio webhooks. Unset = signature check skipped (dev only).
# COMPOSIO_WEBHOOK_SECRET=
# Comma-separated Composio toolkit names to auto-register at boot. Silently does
# nothing without COMPOSIO_API_KEY above — the server logs a warning and skips.
# Names are matched lowercase; already-registered toolkits are left alone, so
# adding one and restarting is safe and idempotent.
#
# These 26 ship with curated display metadata (logo + description) in
# oss/server/src/seed.rs; any other Composio toolkit slug still registers, just
# without a logo or description:
#
#   slack  gmail  github  notion  jira  linear  asana  trello  discord
#   dropbox  salesforce  hubspot  zendesk  intercom  stripe  airtable
#   clickup  monday  gitlab  pagerduty  sentry  confluence  bitbucket
#   googlecalendar  googledrive  googlesheets
#
# SEED_TOOLKITS=gmail,slack,notion,github,googlecalendar

# Public URL of the MCP gateway, injected into every deployed agent's env as
# MCP_GATEWAY_URL. Unset = no MCP env injected at deploy time (agents can't
# reach the gateway at all). For local Docker-based agents talking to a
# host-run server: http://host.docker.internal:8080/api/mcp
# MCP_GATEWAY_PUBLIC_URL=http://host.docker.internal:8080/api/mcp

# Base URL for the generic-connector OAuth 2.1 browser redirect
# ({base}/oauth/callback) — deliberately SEPARATE from MCP_GATEWAY_PUBLIC_URL
# above: that one is told to agent *containers* (may be a Docker-internal
# address, meaningless to a real browser or an OAuth provider's redirect-uri
# validation — confirmed live: Notion's DCR rejects a non-HTTPS/non-loopback
# redirect_uri). This one is opened in the USER'S OWN BROWSER, so it must be
# reachable from there. Falls back to MCP_GATEWAY_PUBLIC_URL when unset, which
# breaks local dev if that's a Docker-only address — if you hit a 502 during
# an OAuth callback (e.g. connecting Notion) locally, set this explicitly:
# MCP_OAUTH_REDIRECT_BASE_URL=http://localhost:8080
# Same problem, but for the separate Composio OAuth connect flow.
# COMPOSIO_CALLBACK_BASE_URL=http://localhost:8080

# Redis-cached TTLs (seconds) — safe to leave at defaults for local dev.
# MCP_SESSION_TTL_SECONDS=300       # resolved backend/session list
# MCP_PERM_CACHE_TTL_SECONDS=30     # per-agent permission context
# MCP_MANIFEST_TTL_SECONDS=300      # aggregated tool manifest served to agents
# MCP_TOOLCOUNT_TTL_SECONDS=3600    # per-connector tool count on catalog cards

# "Upload your own MCP server" (source_kind=uploaded_build) build+deploy settings.
# MCP_UPLOAD_MAX_BYTES=52428800        # 50 MiB
# MCP_UPLOAD_DEFAULT_PORT=8080         # port the uploaded container must bind via $PORT
# MCP_SERVERS_NETWORK=nasiko-mcp-servers-net  # isolated Docker network, separate from DB/Redis/agents
# MCP_UPLOAD_MAX_REPLICAS=1            # KEDA max replicas under Kubernetes; ignored by DockerRuntime
