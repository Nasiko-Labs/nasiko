{
  "$schema": "./manifest.schema.json",
  "strict": false,
  "endpoints": [
    { "id": "shell.health", "editions": ["oss", "ee"], "feature": "shell", "method": "GET", "path": "/health", "auth": "none" },
    { "id": "shell.me", "editions": ["oss", "ee"], "feature": "shell", "method": "GET", "path": "/api/me", "placeholders": ["jti", "iat", "exp"] },
    { "id": "shell.openapi", "feature": "shell", "method": "GET", "path": "/api/openapi.json", "no_replay": "the server's own spec, recorded with the run so liveTypes.test.ts validates the other fixtures against it (plan §7.2); the mocks don't serve it" },

    { "id": "tokenops.dashboard-24h", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "range": "24h", "view": "agent" }, "window": "hour" },
    { "id": "tokenops.dashboard-7d", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "range": "7d", "view": "agent" }, "window": "day" },
    { "id": "tokenops.dashboard-30d", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "range": "30d", "view": "agent" }, "window": "day" },
    { "id": "tokenops.dashboard-workflow-30d", "values": { "ignore": ["$.data.attributions.rows"] }, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "range": "30d", "view": "workflow" }, "window": "day" },
    { "id": "tokenops.dashboard-custom", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "start_time": "{prevWindowStart}", "end_time": "{prevWindowEnd}", "view": "agent" } },
    { "id": "tokenops.dashboard-agent", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "range": "30d", "view": "agent", "agent_id": "{agent0}" }, "window": "day" },
    { "id": "tokenops.timeseries-24h", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/spend-timeseries", "query": { "range": "24h" }, "window": "hour" },
    { "id": "tokenops.timeseries-30d", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/spend-timeseries", "query": { "range": "30d" }, "window": "day" },
    { "id": "tokenops.calendar", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/spend-calendar", "query": { "month": "{anchorMonth}" }, "window": "day" },
    { "id": "tokenops.calendar-prev", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/spend-calendar", "query": { "month": "{prevMonth}" } },
    { "id": "tokenops.day", "values": true, "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/spend-calendar/day", "query": { "date": "{prevDay}" } },
    { "id": "tokenops.providers", "feature": "tokenops", "method": "GET", "path": "/api/llm-router/providers", "allow": [
      { "path": "$.data[].display_name", "reason": "only custom-provider groups carry it (ProviderCatalog skip_serializing_if, llm_router/providers.rs ea233d20); only the mock seeds custom providers (5eed0008)", "since": "2026-09-28" },
      { "path": "$.data[].provider_id", "reason": "only custom-provider groups carry it (ProviderCatalog skip_serializing_if, llm_router/providers.rs ea233d20); only the mock seeds custom providers (5eed0008)", "since": "2026-09-28" }
    ] },
    { "id": "tokenops.top-traces", "feature": "tokenops", "method": "GET", "path": "/api/observability/finops/top-traces", "query": { "range": "30d", "sort_by": "cost", "limit": "25" }, "absent": true },

    { "id": "router.llm-configs", "feature": "router", "method": "GET", "path": "/api/llm-configs" },
    { "id": "router.agent-llm-config", "feature": "router", "method": "GET", "path": "/api/agents/{agent0}/llm-config" },
    { "id": "router.secrets", "feature": "router", "method": "GET", "path": "/api/secrets" },
    { "id": "router.model-registry", "feature": "router", "method": "GET", "path": "/api/model-registry" },
    { "id": "router.custom-providers", "feature": "router", "method": "GET", "path": "/api/custom-providers" },
    { "id": "router.usage-by-agent", "values": true, "feature": "router", "method": "GET", "path": "/api/usage/by-agent", "query": { "days": "30", "limit": "1000" }, "window": "day" },
    { "id": "router.budgets", "feature": "router", "method": "GET", "path": "/api/budgets", "absent": true },
    { "id": "router.budgets-status", "feature": "router", "method": "GET", "path": "/api/budgets/status", "absent": true },
    { "id": "router.budgets-alerts", "feature": "router", "method": "GET", "path": "/api/budgets/alerts", "absent": true },

    { "id": "agents.list", "editions": ["oss", "ee"], "feature": "agents", "method": "GET", "path": "/api/agents", "query": { "limit": "100", "offset": "0" } },
    { "id": "agents.list-mine", "feature": "agents", "method": "GET", "path": "/api/agents", "query": { "limit": "100", "offset": "0", "owner": "{adminId}" } },
    { "id": "agents.detail", "editions": ["oss", "ee"], "feature": "agents", "method": "GET", "path": "/api/agents/{agent0}", "allow": [{ "path": "$.data.compress_enabled", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }, { "path": "$.data.has_coding_skills", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }, { "path": "$.data.metadata", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }, { "path": "$.data.minimal_code_enabled", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }] },
    { "id": "agents.detail-deleted", "feature": "agents", "method": "GET", "path": "/api/agents/{agentDeleted}" },
    { "id": "agents.deployment", "feature": "agents", "method": "GET", "path": "/api/agents/{agentRegistered}/deployment" },
    { "id": "agents.versions", "feature": "agents", "method": "GET", "path": "/api/agents/{agent0}/versions" },
    { "id": "agents.secrets", "feature": "agents", "method": "GET", "path": "/api/agents/{agent0}/secrets" },
    { "id": "agents.grants", "editions": ["oss", "ee"], "feature": "agents", "method": "GET", "path": "/api/agents/{agent0}/grants", "placeholders": ["[].id"] },
    { "id": "agents.grants-users", "editions": ["oss", "ee"], "feature": "agents", "method": "GET", "path": "/api/agents/{agent0}/grants/users" },
    { "id": "agents.grants-agents", "editions": ["oss", "ee"], "feature": "agents", "method": "GET", "path": "/api/agents/{agent0}/grants/agents" },
    { "id": "agents.card", "feature": "agents", "method": "GET", "path": "/api/agents/{agentRegistered}/.well-known/agent-card.json" },
    { "id": "agents.stats", "feature": "agents", "method": "GET", "path": "/api/observability/agent/{agent0}/stats" },
    { "id": "agents.resources", "feature": "agents", "method": "GET", "path": "/api/observability/agent/{agentRegistered}/resources" },
    { "id": "agents.logs", "feature": "agents", "method": "GET", "path": "/api/observability/agents/{agent0}/logs", "query": { "limit": "200" } },
    { "id": "agents.users", "editions": ["oss", "ee"], "feature": "agents", "method": "GET", "path": "/api/users", "query": { "limit": "200" } },
    { "id": "agents.search-users", "feature": "agents", "method": "GET", "path": "/api/search/users", "query": { "q": "adm" } },
    { "id": "agents.settings", "feature": "agents", "method": "GET", "path": "/api/settings" },
    { "id": "sessions.list", "feature": "sessions", "method": "GET", "path": "/api/observability/session/list", "query": { "start_time": "{sessionsStart}", "limit": "25" }, "traces": true },
    { "id": "sessions.detail", "feature": "sessions", "method": "GET", "path": "/api/observability/session/{session0}", "traces": true },
    { "id": "sessions.trace", "feature": "sessions", "method": "GET", "path": "/api/observability/trace/{trace0}", "traces": true, "map_paths": ["$.data.trace.span_lookup"] },
    { "id": "sessions.trace-coding", "feature": "sessions", "method": "GET", "path": "/api/observability/trace/{traceCoding}", "traces": true, "map_paths": ["$.data.trace.span_lookup"] },
    { "id": "sessions.span", "feature": "sessions", "method": "GET", "path": "/api/observability/span/{trace0}/{span0}", "traces": true },
    { "id": "chat.sessions", "feature": "chat", "method": "GET", "path": "/api/chat/sessions", "query": { "limit": "50" } },
    { "id": "chat.messages", "feature": "chat", "method": "GET", "path": "/api/chat/sessions/{chatSession0}/messages", "query": { "limit": "100" }, "placeholders": ["data[].id"], "replay_path": "/api/chat/sessions/5eedc000-0000-4000-8000-00000000c004/messages", "replay_reason": "the live seed's chats are harness turns and the chat mock's are hand-made (c004 is its recorded harness chat), so the row shapes are compared across them", "allow": [{ "path": "$.data[].metadata.coding_agent", "reason": "c004 carries a real CLI capture's coding_agent metadata; the live seed writes messages without metadata", "since": "2026-09-28" }] },
    { "id": "chat.messages-unknown", "feature": "chat", "method": "GET", "path": "/api/chat/sessions/5eed-no-such-session/messages", "query": { "limit": "1" } },
    { "id": "chat.hitl-pending", "feature": "chat", "method": "GET", "path": "/api/hitl/pending" },
    { "id": "chat.flows-unknown", "feature": "chat", "method": "GET", "path": "/api/flows/00000000000000000000000000000000" },
    { "id": "harnesses.usage", "editions": ["oss", "ee"], "feature": "harnesses", "method": "GET", "path": "/api/observability/coding-agents/usage", "query": { "range": "30d", "group_by": "unit" }, "absent": true },
    { "id": "harnesses.org-units", "editions": ["ee"], "feature": "harnesses", "method": "GET", "path": "/api/org/units" },
    { "id": "harnesses.users-me", "editions": ["oss", "ee"], "feature": "harnesses", "method": "GET", "path": "/api/users/me" },
    { "id": "ee.users-me-member", "feature": "ee", "editions": ["ee"], "method": "GET", "path": "/api/users/me", "auth": "member" },
    { "id": "ee.org-units-member", "feature": "ee", "editions": ["ee"], "method": "GET", "path": "/api/org/units", "auth": "member" },
    { "id": "ee.users-member", "feature": "ee", "editions": ["ee"], "method": "GET", "path": "/api/users", "query": { "limit": "200" }, "auth": "member" },
    { "id": "ee.agents-member", "feature": "ee", "editions": ["ee"], "method": "GET", "path": "/api/agents", "query": { "limit": "100", "offset": "0" }, "auth": "member", "allow": [{ "path": "$[].metadata.integration_id", "reason": "the agents mock lists every agent for any persona (harness rows included); EE scopes a member to owned, public and granted agents (ee/server/src/catalog.rs owner_filter). TODO: scope the mock", "since": "2026-09-29" }, { "path": "$[].metadata.source", "reason": "same: harness rows only appear because the mock list is not scoped for a member", "since": "2026-09-29" }] },
    { "id": "ee.agent-detail-member", "feature": "ee", "editions": ["ee"], "method": "GET", "path": "/api/agents/{agent0}", "auth": "member", "allow": [{ "path": "$.data.compress_enabled", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }, { "path": "$.data.has_coding_skills", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }, { "path": "$.data.metadata", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }, { "path": "$.data.minimal_code_enabled", "reason": "served at nasiko-cloud-rs 1a305a63 (catalog/routes.rs AgentDetailResponse) for the Settings feature switches; the fixtures were recorded before. TODO: re-record (npm run record:live -- --only agents,ee)", "since": "2026-10-03" }] },
    { "id": "mcp.connectors", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors" },
    { "id": "mcp.toolkits", "feature": "mcp", "method": "GET", "path": "/api/mcp/composio/toolkits" },
    { "id": "mcp.connector", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpDocs}" },
    { "id": "mcp.connector-upload", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpUpload}" },
    { "id": "mcp.connector-missing", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpUnknown}" },
    { "id": "mcp.build-status", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpFailed}/build-status" },
    { "id": "mcp.build-logs", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpFailed}/build-logs", "excluded": "reads the container runtime's logs, and a seeded upload has no container (M-3 records the Vec<String> shape from the source)" },
    { "id": "mcp.credential-status", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpBearer}/credential/status" },
    { "id": "mcp.oauth-status", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpOauth}/oauth/status" },
    { "id": "mcp.grants", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpDocs}/grants" },
    { "id": "mcp.consumers", "feature": "mcp", "method": "GET", "path": "/api/mcp/connectors/{mcpDocs}/consumers" },
    { "id": "mcp.share-targets", "feature": "mcp", "method": "GET", "path": "/api/mcp/share-targets", "query": { "q": "adm" } },
    { "id": "mcp.agent-connectors", "feature": "mcp", "method": "GET", "path": "/api/mcp/agents/{agent0}/connectors" },
    { "id": "mcp.agent-tools", "feature": "mcp", "method": "GET", "path": "/api/mcp/agents/{agent0}/connectors/{mcpDocs}/tools" },

    { "id": "errors.unknown-route", "editions": ["oss", "ee"], "feature": "errors", "method": "GET", "path": "/api/definitely-not-a-route", "no_replay": "the mock has no catch-all on purpose: tests use onUnhandledRequest error so a missing handler fails loudly; this shape feeds the absent-endpoint checks" },
    { "id": "errors.no-auth", "feature": "errors", "method": "GET", "path": "/api/me", "auth": "none" },
    { "id": "errors.unknown-agent", "feature": "errors", "method": "GET", "path": "/api/observability/finops/dashboard", "query": { "range": "30d", "view": "agent", "agent_id": "00000000-0000-4000-8000-000000000000" } },
    { "id": "errors.requires-admin", "feature": "errors", "method": "GET", "path": "/api/users/me", "hand_written": "oss/server/src/auth/rbac.rs require_user_manager at ea233d20: 403 text/plain 'requires admin role' (a non-admin identity is not recorded on OSS)" }
  ]
}
