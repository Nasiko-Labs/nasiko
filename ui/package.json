{
  "name": "nasiko-react",
  "private": true,
  "version": "0.1.0",
  "description": "Nasiko React SPA workspace: Vite, shared features and Weave, with Rust backend authority; no SSR.",
  "packageManager": "pnpm@12.8.1",
  "engines": {
    "node": ">=22.12 <25",
    "pnpm": "12.8.1"
  },
  "scripts": {
    "preinstall": "node tooling/security/assert-telemetry-env.mjs",
    "check": "pnpm run check:env && pnpm run typecheck && pnpm run lint && pnpm run check:architecture && pnpm run check:boundaries && pnpm run check:format",
    "check:env": "node tooling/security/assert-telemetry-env.mjs",
    "check:format": "prettier --check . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.ee",
    "format": "prettier --write . --ignore-path .gitignore --ignore-path .prettierignore --ignore-path .prettierignore.ee",
    "typecheck": "turbo run typecheck --concurrency=2 && pnpm run typecheck:tests",
    "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
    "lint": "turbo run lint --concurrency=1",
    "check:architecture": "node tooling/routes/generate.mjs --check && node tooling/routes/inventory-check.mjs && node tooling/architecture/exports.mjs --check && node tooling/architecture/check.mjs",
    "check:bundles": "node tooling/bundles/check.mjs",
    "security:check": "node tooling/security/check.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "test:security": "vitest run --project security --project security-ui",
    "test:motion": "playwright test -c tests/motion/playwright.config.ts",
    "test:contract": "vitest run --project contract",
    "build": "turbo run build",
    "dev": "pnpm --filter @nasiko/web dev",
    "storybook": "pnpm --filter @nasiko-ee/workspace storybook",
    "snapshot": "bash tooling/snapshot.sh",
    "provenance:verify": "node tooling/provenance/verify.mjs",
    "test:browser": "pnpm --filter @nasiko-ee/workspace exec storybook build --quiet -o storybook-static && playwright test -c tests/browser/playwright.config.ts",
    "test:browser:only": "playwright test -c tests/browser/playwright.config.ts",
    "test:replay": "vitest run --project replay --project replay-ui",
    "prompt:export": "tsx tooling/prompt/export.mts",
    "prompt:check": "tsx tooling/prompt/export.mts --check",
    "prompt:sync": "tsx tooling/prompt/export.mts --sync",
    "test:perf": "playwright test -c tests/perf/playwright.config.ts",
    "check:oss-export": "node ee/tooling/publication/oss-export.mjs",
    "routes:generate": "node tooling/routes/generate.mjs",
    "exports:sync": "node tooling/architecture/exports.mjs",
    "check:inventory": "node tooling/routes/inventory-check.mjs",
    "test:journeys": "playwright test -c tests/journeys/playwright.config.ts",
    "test:weave": "playwright test -c ee/tests/weave/playwright.config.ts",
    "check:boundaries": "node tooling/editions/boundaries.mjs",
    "publication:sync": "node ee/tooling/publication/public-workspace.mjs",
    "publication:check": "node ee/tooling/publication/public-workspace.mjs --check",
    "check:ee-artifact": "node ee/app/scripts/check-artifact.mjs",
    "build:registry": "pnpm --filter @nasiko-ee/registry-app build"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@eslint/js": "9.39.5",
    "@nasiko/api-client": "workspace:*",
    "@nasiko/app-core": "workspace:*",
    "@nasiko/app-shell": "workspace:*",
    "@nasiko/contracts": "workspace:*",
    "@nasiko/conversation": "workspace:*",
    "@nasiko/data-access": "workspace:*",
    "@nasiko/extensions": "workspace:*",
    "@nasiko/features": "workspace:*",
    "@nasiko/mocks": "workspace:*",
    "@nasiko/testing": "workspace:*",
    "@nasiko/ui": "workspace:*",
    "@nasiko/weave-catalog": "workspace:*",
    "@nasiko/weave-contracts": "workspace:*",
    "@nasiko/weave-data": "workspace:*",
    "@nasiko/weave-runtime": "workspace:*",
    "@openuidev/lang-core": "0.3.0",
    "@openuidev/react-lang": "0.3.0",
    "@playwright/test": "1.63.0",
    "@tanstack/query-core": "5.104.0",
    "@tanstack/react-router": "1.170.39",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/node": "24.6.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "dependency-cruiser": "18.5.0",
    "eslint": "9.39.5",
    "eslint-plugin-boundaries": "7.2.0",
    "eslint-plugin-react-hooks": "7.0.1",
    "jsdom": "30.1.1",
    "msw": "3.0.1",
    "prettier": "3.9.9",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "tsx": "4.21.0",
    "turbo": "2.11.3",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vite": "8.3.1",
    "vitest": "5.0.3"
  }
}
