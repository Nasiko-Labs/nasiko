{
  "name": "@nasiko/mocks",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Development and test-only mocks (MSW handlers from the lab seed). A release build folds the mock boot away (VITE_NASIKO_API_MODE is inlined); production exclusion is checked in tests/e2e and the bundle checks.",
  "sideEffects": false,
  "exports": {
    "./agents": "./src/agents.ts",
    "./aggregate": "./src/aggregate.ts",
    "./anchor": "./src/anchor.ts",
    "./chat": "./src/chat.ts",
    "./chatStore": "./src/chatStore.ts",
    "./deploy": "./src/deploy.ts",
    "./flows": "./src/flows.ts",
    "./handlers": "./src/handlers.ts",
    "./harnessUsage": "./src/harnessUsage.ts",
    "./mock-boot": "./src/mock-boot.tsx",
    "./node": "./src/node.ts",
    "./observability": "./src/observability.ts",
    "./optimization": "./src/optimization.ts",
    "./router": "./src/router.ts",
    "./seed": "./src/seed.ts",
    "./seed-harness": "./src/seed-harness.ts",
    "./spanBuilder": "./src/spanBuilder.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@nasiko/app-core": "workspace:*",
    "@nasiko/contracts": "workspace:*",
    "@nasiko/data-access": "workspace:*",
    "@nasiko/features": "workspace:*",
    "msw": "3.0.1",
    "react": "19.3.0"
  },
  "devDependencies": {
    "@nasiko/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
