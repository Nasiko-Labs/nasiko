{
  "name": "@nasiko/app-shell",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The workspace application shell shared by the OSS and EE composition roots: root document, sign-in, signed-in layout and guard, sidebar, route states. Composes public features; accepts Enterprise behaviour only through the edition slots.",
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    "./fonts.css": "./src/fonts/fonts.css",
    "./foundation/FoundationLayout": "./src/foundation/FoundationLayout.tsx",
    "./login/LoginRoute": "./src/login/LoginRoute.tsx",
    "./root/RootLayout": "./src/root/RootLayout.tsx",
    "./router": "./src/router.tsx",
    "./testing/render-app": "./src/testing/render-app.tsx",
    "./testing/routes.gen": "./src/testing/routes.gen.tsx",
    "./workspace/early-session": "./src/workspace/early-session.ts",
    "./workspace/StatusRoute": "./src/workspace/StatusRoute.tsx"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@nasiko/app-core": "workspace:*",
    "@nasiko/contracts": "workspace:*",
    "@nasiko/data-access": "workspace:*",
    "@nasiko/features": "workspace:*",
    "@nasiko/mocks": "workspace:*",
    "@nasiko/ui": "workspace:*",
    "@tanstack/react-query": "5.104.0",
    "lucide-react": "1.49.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "4.6.5",
    "@tanstack/react-router": "1.170.39"
  },
  "devDependencies": {
    "@nasiko/config": "workspace:*",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "msw": "3.0.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
