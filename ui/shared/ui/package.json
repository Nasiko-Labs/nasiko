{
  "name": "@nasiko/ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The one design foundation: shadcn base-nova primitives on Base UI, Nasiko theme tokens, density and motion contracts, data/agent composites. Charts and tables are separate lazy entries so the initial bundle never carries them.",
  "sideEffects": [
    "*.css"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./primitives": "./src/primitives/index.ts",
    "./composites": "./src/composites/index.ts",
    "./motion": "./src/motion/index.ts",
    "./theme": "./src/theme/index.ts",
    "./charts": "./src/charts/index.ts",
    "./charts-kit": "./src/charts-kit/index.ts",
    "./table": "./src/table/index.ts",
    "./cn": "./src/lib/cn.ts",
    "./lib": "./src/lib/index.ts",
    "./styles.css": "./src/styles/index.css",
    "./styles/shadcn-tailwind.css": "./src/styles/shadcn-tailwind.css",
    "./styles/tokens.css": "./src/styles/tokens.css",
    "./styles/operational-motion.css": "./src/styles/operational-motion.css",
    "./toast": "./src/toast/index.tsx",
    "./motion/testing": "./src/motion/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src --max-warnings 0"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@date-fns/tz": "1.5.0",
    "@nasiko/contracts": "workspace:*",
    "@nasiko/data-access": "workspace:*",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.13",
    "@visx/axis": "4.0.0",
    "@visx/curve": "4.0.0",
    "@visx/event": "4.0.0",
    "@visx/grid": "4.0.0",
    "@visx/group": "4.0.0",
    "@visx/responsive": "4.0.0",
    "@visx/scale": "4.0.0",
    "@visx/shape": "4.0.0",
    "class-variance-authority": "0.7.1",
    "cmdk": "1.1.1",
    "cn": "0.2.4",
    "d3-array": "3.2.4",
    "d3-shape": "3.2.0",
    "date-fns": "4.4.0",
    "lucide-react": "1.49.0",
    "motion": "13.4.6",
    "react": "19.3.0",
    "react-day-picker": "10.0.2",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@nasiko/config": "workspace:*",
    "@storybook/react-vite": "10.6.1",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.7",
    "@types/d3-array": "3.2.2",
    "@types/d3-shape": "3.2.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "jsdom": "30.1.1",
    "storybook": "10.6.1",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
